# Tệp này chỉ liệt kê tên biến; không điền giá trị bí mật vào đây.

# Mức log tối thiểu của Serilog: Verbose, Debug, Information, Warning, Error, Fatal. Không đặt thì dùng giá trị trong appsettings.json (Information).
Serilog__MinimumLevel=Information

# Giới hạn số request mỗi phút cho nhóm ẩn danh (đăng ký, đăng nhập, làm mới token) tính theo IP. Đã có giá trị trong appsettings.json (10); đặt biến này chỉ khi cần đổi.
RateLimit__AuthPermitPerMinute=10

# Khóa ký JWT (BÍ MẬT, tối thiểu 32 ký tự). Chỉ đặt ở biến môi trường của máy/nơi triển khai; không điền giá trị thật vào repo và không đặt trong launchSettings.json (tệp này được commit).
Jwt__SigningKey=

# Thời hạn access token (phút) và refresh token (ngày). Đã có giá trị trong appsettings.json (15 và 7); đặt biến này chỉ khi cần đổi.
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
